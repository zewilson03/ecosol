NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_URL=https://SEU_DOMINIO_ECOSOL
ECOSOL_DATA_DIR=/var/lib/ecosol
# Segredo temporário e forte, usado uma única vez no primeiro provisionamento.
# Remova do ambiente após criar o primeiro administrador nominal.
# ADMIN_PASSWORD=

# A emissão real permanece bloqueada até os portões bancários serem aprovados.
BANCARIO_EXECUTOR_MODO=desligado
SICOOB_AMBIENTE=producao
ECOSOL_LIMITE_ALERTA_DIVIDA_CENTAVOS=1000000

# Preencha segredos somente em /etc/ecosol/ecosol.env no servidor.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REDIRECT_URI=https://SEU_DOMINIO_ECOSOL/api/admin/gmail/oauth/retorno
# GMAIL_TOKEN_ENCRYPTION_KEY=
# SICOOB_PRODUCAO_CLIENT_ID=
# SICOOB_PRODUCAO_MTLS_PFX_PATH=/etc/ecosol/segredos/chave-principal.pfx
# SICOOB_PRODUCAO_MTLS_PFX_PASSPHRASE=
# SICOOB_PRODUCAO_NUMERO_CLIENTE=
