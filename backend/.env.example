# Copie para .env.local antes de executar.
ADMIN_PASSWORD=ADM123
APP_URL=http://localhost:3000
# Em produção, use obrigatoriamente uma origem HTTPS definitiva.
# Pasta local de planilhas (somente leitura; padrão: Desktop/00 - Planilhas Atualizadas)
# ECOSOL_PLANILHAS_DIR=C:\Users\User\Desktop\00 - Planilhas Atualizadas
# Para entrega real dos links de ativação e recuperação:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Ecosol <contato@ecosol.com.br>

# Integração bancária: o executor nasce desligado e a fila nasce pausada.
BANCARIO_EXECUTOR_MODO=desligado
SICOOB_AMBIENTE=homologacao
# Referência interna sem agência, conta, documento ou outro dado bancário sensível.
# SICOOB_CONTA_REFERENCIA=

# Contrato oficial confirmado no Portal Developers em 23/10/2026.
SICOOB_HOMOLOGACAO_API_BASE_URL=https://api.sicoob.com.br/cobranca-bancaria/v3
SICOOB_HOMOLOGACAO_OAUTH_TOKEN_URL=https://auth.sicoob.com.br/auth/realms/cooperado/protocol/openid-connect/token
# SICOOB_HOMOLOGACAO_CLIENT_ID=
# O fluxo mTLS validado não utiliza client secret. Só preencha se o Sicoob
# alterar formalmente o contrato da aplicação.
# SICOOB_HOMOLOGACAO_CLIENT_SECRET=
SICOOB_HOMOLOGACAO_OAUTH_SCOPE=boletos_inclusao boletos_consulta
SICOOB_HOMOLOGACAO_CONTRATO_VERSAO=cobranca-bancaria-v3
# API de Conta Corrente: requer o escopo cco_consulta no OAuth.
# SICOOB_HOMOLOGACAO_CONTA_CORRENTE_API_BASE_URL=https://api.sicoob.com.br/conta-corrente/v4
# SICOOB_HOMOLOGACAO_CONTA_CORRENTE_NUMERO_CONTA=
# SICOOB_HOMOLOGACAO_MTLS_CERT_PATH=
# SICOOB_HOMOLOGACAO_MTLS_KEY_PATH=
# SICOOB_HOMOLOGACAO_MTLS_KEY_PASSPHRASE=
# Alternativa ao par PEM acima: informe o PFX e sua senha. Nunca use os dois
# formatos simultaneamente e mantenha o arquivo fora do repositório.
# SICOOB_HOMOLOGACAO_MTLS_PFX_PATH=
# SICOOB_HOMOLOGACAO_MTLS_PFX_PASSPHRASE=
# Dados do convênio de cobrança são obrigatórios antes de mapear um boleto.
# Não presuma códigos: copie somente os valores confirmados pelo Sicoob.
# SICOOB_HOMOLOGACAO_COBRANCA_NUMERO_CLIENTE=
# SICOOB_HOMOLOGACAO_COBRANCA_CODIGO_MODALIDADE=
# SICOOB_HOMOLOGACAO_COBRANCA_NUMERO_CONTA_CORRENTE=
# SICOOB_HOMOLOGACAO_COBRANCA_ESPECIE_DOCUMENTO=
# SICOOB_HOMOLOGACAO_COBRANCA_IDENTIFICACAO_EMISSAO=
# SICOOB_HOMOLOGACAO_COBRANCA_IDENTIFICACAO_DISTRIBUICAO=
# Opcional: só use quando o Sicoob orientar expressamente para um contrato
# secundário de cobrança.
# SICOOB_HOMOLOGACAO_COBRANCA_NUMERO_CONTRATO=
# SICOOB_HOMOLOGACAO_COBRANCA_GERAR_PDF=NAO

# Produção usa credenciais e endereços próprios. Só habilite após homologação,
# revisão operacional e plano de recuperação aprovados.
# SICOOB_PRODUCAO_API_BASE_URL=
# SICOOB_PRODUCAO_OAUTH_TOKEN_URL=
# SICOOB_PRODUCAO_CLIENT_ID=
# SICOOB_PRODUCAO_CLIENT_SECRET=
# SICOOB_PRODUCAO_OAUTH_SCOPE=
# SICOOB_PRODUCAO_CONTRATO_VERSAO=
# SICOOB_PRODUCAO_CONTA_CORRENTE_API_BASE_URL=https://api.sicoob.com.br/conta-corrente/v4
# SICOOB_PRODUCAO_CONTA_CORRENTE_NUMERO_CONTA=
# SICOOB_PRODUCAO_MTLS_CERT_PATH=
# SICOOB_PRODUCAO_MTLS_KEY_PATH=
# SICOOB_PRODUCAO_MTLS_KEY_PASSPHRASE=
# SICOOB_PRODUCAO_MTLS_PFX_PATH=
# SICOOB_PRODUCAO_MTLS_PFX_PASSPHRASE=
# SICOOB_PRODUCAO_HABILITADA=NAO
# O servidor permanece local por padrão. Para teste temporário em celular na
# mesma rede privada, use HOST=0.0.0.0 e APP_URL com o IPv4 do computador.
HOST=127.0.0.1
# Alerta interno quando a dívida vencida de uma UC ultrapassar este valor.
ECOSOL_LIMITE_ALERTA_DIVIDA_CENTAVOS=1000000
